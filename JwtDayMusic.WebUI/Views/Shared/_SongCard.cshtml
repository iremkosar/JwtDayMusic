@model JwtDayMusic.WebUI.Models.SongViewModel

<article class="song-card"
         data-song-card
         data-song-id="@Model.SongId"
         data-category="@Model.Category?.ToLowerInvariant()"
         data-badge="@Model.Badge?.ToLowerInvariant()"
         data-title="@Model.Title"
         data-artist="@Model.ArtistName"
         data-cover="@Model.CoverImageUrl"
         data-duration-seconds="@((int)Model.Duration.TotalSeconds)">

    <div class="song-cover" style="background-image:url('@Model.CoverImageUrl')">
        <img src="@Model.CoverImageUrl" alt="@Model.Title cover" loading="lazy" />

        @if (!string.IsNullOrEmpty(Model.Badge))
        {
            <span class="song-badge badge-@Model.Badge.ToLowerInvariant()">@Model.Badge</span>
        }

        <button type="button"
                class="song-fav-btn @(Model.IsFavorited ? "is-favorited" : "")"
                data-fav-btn
                aria-label="Add to favorites">
            <i class="bi bi-heart@(Model.IsFavorited ? "-fill" : "")"></i>
        </button>

        <button type="button" class="song-playlist-btn" data-add-to-playlist-btn aria-label="Add to playlist">
            <i class="bi bi-plus-lg"></i>
        </button>

        <button type="button" class="song-play-btn" data-play-song aria-label="Play @Model.Title">
            <i class="bi bi-play-fill"></i>
        </button>
    </div>

    <div class="song-info">
        <p class="song-title mb-0">@Model.Title</p>
        <p class="song-artist mb-0">@Model.ArtistName</p>
        <p class="song-duration mb-0">@Model.Duration.ToString(@"m\:ss")</p>
    </div>
</article>

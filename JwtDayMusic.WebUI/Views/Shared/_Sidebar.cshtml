@inject IHttpContextAccessor HttpContextAccessor
@using JwtDayMusic.WebUI.Helpers

@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    bool IsActive(string controllerName) =>
        string.Equals(currentController, controllerName, StringComparison.OrdinalIgnoreCase);

    bool IsActiveAction(string controllerName, string actionName) =>
        IsActive(controllerName) && string.Equals(currentAction, actionName, StringComparison.OrdinalIgnoreCase);

    var token = HttpContextAccessor.HttpContext?.Session.GetString("JwtToken");
    var (displayName, roles) = JwtClaimsReader.Read(token);
    var highestRole = JwtClaimsReader.GetHighestRole(roles);
    var initials = JwtClaimsReader.GetInitials(displayName);
    var roleBadgeClass = "role-badge-" + highestRole.ToLowerInvariant();
}

<aside class="sidebar">
    <div class="sidebar-scroll">
        <a asp-controller="Home" asp-action="Index" class="sidebar-brand">
            <span class="sidebar-brand-mark"><i class="bi bi-soundwave"></i></span>
            <span class="sidebar-brand-text">Cadence</span>
        </a>

        <nav class="sidebar-nav">
            <a asp-controller="Home" asp-action="Index" class="sidebar-link @(IsActive("Home") ? "active" : "")">
                <i class="bi bi-house"></i> Home
            </a>

            <p class="sidebar-section-label">Keþfet</p>

            <a asp-controller="Artist" asp-action="ArtistList" class="sidebar-link @(IsActive("Artist") && currentAction != "Following" ? "active" : "")">
                <i class="bi bi-mic"></i> Artists
            </a>
            <a asp-controller="Song" asp-action="Index" class="sidebar-link @(IsActive("Song") ? "active" : "")">
                <i class="bi bi-music-note-beamed"></i> Songs
            </a>
            <a asp-controller="Genre" asp-action="Index" class="sidebar-link @(IsActive("Genre") ? "active" : "")">
                <i class="bi bi-tags"></i> Genres
            </a>
            <a asp-controller="Album" asp-action="Index" class="sidebar-link">
                <i class="bi bi-disc"></i> Albums
            </a>
            <a asp-controller="History" asp-action="Recommendations" class="sidebar-link @(IsActiveAction("History", "Recommendations") ? "active" : "")">
                <i class="bi bi-stars"></i> Recommended
            </a>

            <p class="sidebar-section-label">Kütüphane</p>

            <a asp-controller="Favorite" asp-action="Index" class="sidebar-link @(IsActive("Favorite") ? "active" : "")">
                <i class="bi bi-heart"></i> Favorites
            </a>
            <a asp-controller="Artist" asp-action="Following" class="sidebar-link @(IsActiveAction("Artist", "Following") ? "active" : "")">
                <i class="bi bi-person-check"></i> Takip Ettiklerim
            </a>
            <a asp-controller="Playlist" asp-action="Index" class="sidebar-link @(IsActive("Playlist") ? "active" : "")">
                <i class="bi bi-collection-play"></i> Playlists
            </a>
            <a asp-controller="History" asp-action="Index" class="sidebar-link @(IsActiveAction("History", "Index") ? "active" : "")">
                <i class="bi bi-clock-history"></i> Recently Played
            </a>

            <p class="sidebar-section-label">Hesap</p>

            <a asp-controller="Membership" asp-action="Index" class="sidebar-link">
                <i class="bi bi-gem"></i> Premium
            </a>
            <a asp-controller="Settings" asp-action="Index" class="sidebar-link">
                <i class="bi bi-gear"></i> Settings
            </a>
            <a asp-controller="Login" asp-action="Logout" class="sidebar-link">
                <i class="bi bi-box-arrow-right"></i> Logout
            </a>
        </nav>
    </div>

    <div class="sidebar-account">
        <p class="sidebar-account-label mb-0">Hesabým</p>
        <div class="sidebar-account-row">
            <div class="sidebar-account-avatar">@initials</div>
            <div class="sidebar-account-meta">
                <span class="sidebar-account-name">@displayName</span>
                <span class="role-badge @roleBadgeClass">
                    <i class="bi bi-star-fill"></i> @highestRole
                </span>
            </div>
        </div>
    </div>
</aside>

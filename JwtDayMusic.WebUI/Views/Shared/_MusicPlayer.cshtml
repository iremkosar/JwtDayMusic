<footer class="music-player">
    <audio id="audioPlayer" preload="metadata"></audio>
    <div class="player-grid">

        <div class="player-track">
            <img src="https://picsum.photos/seed/nowplaying/120" alt="" class="player-cover" data-player-cover />
            <div class="player-track-meta">
                <p class="player-track-title mb-0" data-player-title>Midnight Echoes</p>
                <p class="player-track-artist mb-0" data-player-artist>Lena Cross</p>
            </div>
            <button class="player-track-fav" type="button" aria-label="Add to favorites">
                <i class="bi bi-heart"></i>
            </button>
        </div>

        <div class="player-center">
            <div class="player-controls">
                <button type="button" aria-label="Shuffle" data-player-shuffle>
                    <i class="bi bi-shuffle"></i>
                </button>
                <button type="button" aria-label="Previous track">
                    <i class="bi bi-skip-start-fill"></i>
                </button>
                <button type="button" class="player-play-btn" aria-label="Play" data-player-play>
                    <i class="bi bi-play-fill"></i>
                </button>
                <button type="button" aria-label="Next track">
                    <i class="bi bi-skip-end-fill"></i>
                </button>
                <button type="button" aria-label="Repeat" data-player-repeat>
                    <i class="bi bi-repeat"></i>
                </button>
            </div>

            <div class="player-timeline">
                <span class="player-time" data-player-current-time>0:00</span>
                <input type="range" class="range-slider" min="0" max="100" value="0" data-player-progress aria-label="Seek" />
                <span class="player-time" data-player-duration>3:30</span>
            </div>
        </div>

        <div class="player-side">
            <button type="button" class="lyrics-btn" aria-label="Lyrics">
                <i class="bi bi-text-paragraph"></i>
            </button>
            <button type="button" aria-label="Queue">
                <i class="bi bi-list-ol"></i>
            </button>
            <div class="player-volume">
                <i class="bi bi-volume-up" data-player-volume-icon></i>
                <input type="range" class="range-slider" min="0" max="100" value="70" data-player-volume aria-label="Volume" />
            </div>
        </div>

    </div>
</footer>

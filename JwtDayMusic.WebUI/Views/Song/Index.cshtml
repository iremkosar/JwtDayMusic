@model IEnumerable<JwtDayMusic.WebUI.Models.SongViewModel>
@using JwtDayMusic.WebUI.Models

@{
    ViewData["Title"] = "Music Library";
    ViewData["PageTitle"] = "Music Library";
    ViewData["PageSubtitle"] = "Discover and enjoy your favorite music.";
    Layout = "_Layout";

    var songs = Model ?? Enumerable.Empty<SongViewModel>();

    // Filtre butonlarý artýk veritabanýndaki gerçek verilerden üretiliyor:
    // 1) Þarkýlarda geçen türler (alfabetik, büyük/küçük harf farký tek sayýlýr)
    var genres = songs
        .Where(s => !string.IsNullOrWhiteSpace(s.Category))
        .Select(s => s.Category.Trim())
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(g => g, StringComparer.OrdinalIgnoreCase)
        .ToList();

    // 2) Üyelik paketi butonlarý, sadece o pakette en az bir þarký varsa gösterilir
    var packages = new[] { "Gold", "Premium", "Elit" }
        .Where(p => songs.Any(s => string.Equals(s.Badge, p, StringComparison.OrdinalIgnoreCase)))
        .ToList();
}

<section class="category-filters">
    <button type="button" class="category-pill active" data-category-pill="all">All</button>

    @foreach (var genre in genres)
    {
        <button type="button" class="category-pill" data-category-pill="@genre.ToLowerInvariant()">@genre</button>
    }

    @foreach (var package in packages)
    {
        <button type="button" class="category-pill" data-category-pill="@package.ToLowerInvariant()">@package</button>
    }
</section>

@if (songs.Any())
{
    <div class="song-grid">
        @foreach (var song in songs)
        {
            <partial name="_SongCard" model="song" />
        }
    </div>
}

<div class="empty-state" data-empty-state style="display:none;">
    <i class="bi bi-music-note-list"></i>
    <p class="mb-0">No songs match this filter.</p>
    <p class="mb-0">Try a different category or search term.</p>
</div>

@if (!songs.Any())
{
    <div class="empty-state">
        <i class="bi bi-music-note-list"></i>
        <p class="mb-0">Your library is empty right now.</p>
        <p class="mb-0">New songs will show up here as soon as they're added.</p>
    </div>
}

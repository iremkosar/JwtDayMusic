@model IEnumerable<JwtDayMusic.WebUI.Dtos.ResultArtistDto>

@{
    ViewData["Title"] = "Popüler Sanatçılar";
    ViewData["PageTitle"] = "Popüler Sanatçılar";
    ViewData["PageSubtitle"] = $"{Model?.Count() ?? 0} sanatçı listeleniyor";
    Layout = "_Layout";

    var turkishCulture = new System.Globalization.CultureInfo("tr-TR");
    var followingIds = ViewBag.FollowingIds as HashSet<int> ?? new HashSet<int>();

    var allGenres = (Model ?? Enumerable.Empty<JwtDayMusic.WebUI.Dtos.ResultArtistDto>())
        .SelectMany(a => (a.Genres ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        .Where(g => !string.IsNullOrEmpty(g))
        .Distinct()
        .OrderBy(g => g)
        .ToList();
}

<section class="category-filters">
    <button type="button" class="category-pill active" data-artist-genre-pill="all">Tümü</button>
    @foreach (var genre in allGenres)
    {
        <button type="button" class="category-pill" data-artist-genre-pill="@genre.ToLowerInvariant()">@genre</button>
    }
</section>

@if (Model != null && Model.Any())
{
    <div class="artist-grid" style="margin-top:1.75rem;">
        @foreach (var artist in Model)
        {
            var isFollowing = followingIds.Contains(artist.ArtistId);

            <div class="artist-card-v2"
                 data-artist-card
                 data-artist-id="@artist.ArtistId"
                 data-genres="@((artist.Genres ?? "").ToLowerInvariant())">

                <a asp-action="ArtistDetails" asp-route-id="@artist.ArtistId" class="artist-card-v2-cover">
                    <img src="@artist.ImageUrl" alt="@artist.Name" loading="lazy" />
                </a>

                <div class="artist-card-v2-body">
                    <a asp-action="ArtistDetails" asp-route-id="@artist.ArtistId" class="artist-card-v2-name">
                        @artist.Name
                        @if (artist.IsVerified)
                        {
                            <i class="bi bi-patch-check-fill artist-verified"></i>
                        }
                    </a>
                    <p class="artist-card-v2-genres mb-0">@artist.Genres</p>

                    <div class="artist-card-v2-footer">
                        <span class="artist-card-v2-listeners">
                            <i class="bi bi-person-fill"></i>
                            @artist.MonthlyListeners.ToString("N0", turkishCulture)
                        </span>
                        <button type="button"
                                class="follow-btn @(isFollowing ? "is-following" : "")"
                                data-follow-btn>
                            <span class="follow-btn-label">@(isFollowing ? "Takip Ediliyor" : "Takip Et")</span>
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="empty-state" data-artist-empty-state style="display:none;">
        <i class="bi bi-mic"></i>
        <p class="mb-0">Bu türde sanatçı bulunamadı.</p>
    </div>
}
else
{
    <div class="empty-state">
        <i class="bi bi-mic"></i>
        <p class="mb-0">Henüz sanatçı eklenmemiş.</p>
    </div>
}

@model List<JwtDayMusic.WebUI.Models.SongViewModel>

@{
    ViewData["Title"] = "Dinleme Geçmişi";
    ViewData["PageTitle"] = "Dinleme Geçmişi";
    ViewData["PageSubtitle"] = "En son dinlediğiniz şarkılar.";
    Layout = "_Layout";
}

@if (Model != null && Model.Any())
{
    <div class="song-grid">
        @foreach (var song in Model)
        {
            <partial name="_SongCard" model="song" />
        }
    </div>
}
else
{
    <div class="empty-state">
        <i class="bi bi-clock-history"></i>
        <p class="mb-0">Henüz hiç şarkı dinlemediniz.</p>
        <p class="mb-0"><a asp-action="Index" asp-controller="Song" class="back-link" style="display:inline-flex;margin-top:0.75rem;">Şarkıları keşfedin</a></p>
    </div>
}

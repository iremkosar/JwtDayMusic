@model List<JwtDayMusic.WebUI.Models.SongViewModel>

@{
    ViewData["Title"] = "Önerilenler";
    ViewData["PageTitle"] = "Bunları da Sevebilirsiniz";
    ViewData["PageSubtitle"] = "Dinleme geçmişiniz analiz edilerek sizin için seçildi.";
    Layout = "_Layout";
}

<div class="ai-banner">
    <div class="ai-banner-icon">
        <i class="bi bi-cpu"></i>
    </div>
    <div class="ai-banner-text">
        <p class="ai-banner-title mb-0">ML.NET Yapay Zeka Analizi</p>
        <p class="ai-banner-subtitle mb-0">Dinleme alışkanlıklarınız Matrix Factorization algoritmasıyla analiz edildi. Aşağıdaki öneriler size özel hesaplandı.</p>
    </div>
    <span class="ai-banner-badge">AI POWERED</span>
</div>

@if (Model != null && Model.Any())
{
    <div class="song-grid">
        @foreach (var song in Model)
        {
            <partial name="_SongCard" model="song" />
        }
    </div>
}
else
{
    <div class="empty-state">
        <i class="bi bi-stars"></i>
        <p class="mb-0">Öneri oluşturmak için biraz daha şarkı dinlemeniz gerekiyor.</p>
        <p class="mb-0"><a asp-action="Index" asp-controller="Song" class="back-link" style="display:inline-flex;margin-top:0.75rem;">Şarkıları keşfedin</a></p>
    </div>
}

@model List<JwtDayMusic.WebUI.Models.SongViewModel>

@{
    ViewData["Title"] = "Önerilenler";
    ViewData["PageTitle"] = "Sizin İçin Önerilenler";
    ViewData["PageSubtitle"] = "Dinleme geçmişinize göre beğenebileceğiniz şarkılar.";
    Layout = "_Layout";
}

@if (Model != null && Model.Any())
{
    <div class="song-grid">
        @foreach (var song in Model)
        {
            <partial name="_SongCard" model="song" />
        }
    </div>
}
else
{
    <div class="empty-state">
        <i class="bi bi-stars"></i>
        <p class="mb-0">Öneri oluşturmak için biraz daha şarkı dinlemeniz gerekiyor.</p>
        <p class="mb-0"><a asp-action="Index" asp-controller="Song" class="back-link" style="display:inline-flex;margin-top:0.75rem;">Şarkıları keşfedin</a></p>
    </div>
}
